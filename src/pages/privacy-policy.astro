---
import Layout from '../layouts/Layout.astro';
import Body from '../components/catania/Body.astro';
import { frontmatter } from '../content/privacy-policy.mdx';

const bodyItem = frontmatter.data.find((c) => c.section === 'Body' && (c.publish || 'Y').toUpperCase() === 'Y');


---
<Layout
  title={frontmatter.metaTitle || "Privacy Policy"}
  description={frontmatter.metaDescription || "Default description"}
>
{bodyItem && <Body {...bodyItem} folderPath="privacy-policy" />}

</Layout>
