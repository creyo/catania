---
import Layout from '../layouts/Layout.astro';
import HomeTop from '../components/catania/HomeTop.astro';
import WhoWeAre from '../components/catania/WhoWeAre.astro';
import Feature from '../components/catania/Feature.astro';
import HomeFeature4 from '../components/catania/HomeFeature4.astro';
import Testimonial from '../components/catania/Testimonial.astro';
import OurWork from '../components/catania/OurWork.astro';
import LastBlock from '../components/catania/LastBlock.astro';
import { frontmatter } from '../content/index.mdx';

const topItem = frontmatter.data.find((c) => c.section === 'Top' && (c.publish || 'Y').toUpperCase() === 'Y');

const feature1Item = frontmatter.data.find((c) => c.section === 'Feature1' && (c.publish || 'Y').toUpperCase() === 'Y');

const feature2Items = frontmatter.data.filter((c) => c.section === 'Feature2' && (c.publish || 'Y').toUpperCase() === 'Y').sort((a, b) => Number(a.order || 0) - Number(b.order || 0));

const feature4Item = frontmatter.data.find((c) => c.section === 'Feature4' && (c.publish || 'Y').toUpperCase() === 'Y');

const testimonialItems = frontmatter.data.filter((c) => c.section === 'Testimonial' && (c.publish || 'Y').toUpperCase() === 'Y').sort((a, b) => Number(a.order || 0) - Number(b.order || 0));

const ourworkItem = frontmatter.data.find((c) => c.section === 'OurWork' && (c.publish || 'Y').toUpperCase() === 'Y');

const lastblockItem = frontmatter.data.find((c) => c.section === 'LastBlock' && (c.publish || 'Y').toUpperCase() === 'Y');


---
<Layout
  title={frontmatter.metaTitle || "Home"}
  description={frontmatter.metaDescription || "Default description"}
>
{topItem && <HomeTop {...topItem} folderPath="index" />}
{feature1Item && <WhoWeAre {...feature1Item} folderPath="index" />}
{feature2Items.length > 0 && <Feature items={feature2Items} folderPath="index" />}
{feature4Item && <HomeFeature4 {...feature4Item} folderPath="index" />}
{testimonialItems.length > 0 && <Testimonial items={testimonialItems} folderPath="index" />}
{ourworkItem && <OurWork {...ourworkItem} folderPath="index" />}
{lastblockItem && <LastBlock {...lastblockItem} folderPath="index" />}

</Layout>
