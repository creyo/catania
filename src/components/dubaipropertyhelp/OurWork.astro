---
import '../../styles/catania/our-work.css';
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/imageResolver';

interface Props {
  title: string;
  subTitle?: string;
  description?: string;
  image: string;
}

const { title, subTitle, description, image } = Astro.props;

// Parse list of images
const imageFiles = image
  ? image.split(',').map(img => img.trim()).filter(Boolean)
  : [];

// Resolve all images to ImageMetadata objects in the frontmatter block
const resolvedImages = imageFiles.map(img => resolveImage(img));
---

{resolvedImages.length > 0 && (
  <section class="ourwork">
    <div class="ourwork-container">
      {(title || subTitle || description) && (
        <div class="ourwork-header">
          {subTitle && <span class="ourwork-badge">{subTitle}</span>}
          {title && <h2 class="ourwork-heading">{title}</h2>}
          {description && <p class="ourwork-description">{description}</p>}
        </div>
      )}

      <div class="ourwork-grid">
        {resolvedImages.map((imageSrc) => (
          <div class="ourwork-card">
            <Image 
              class="ourwork-image" 
              src={imageSrc} 
              alt={title || 'Catania Kitchen Work'} 
              widths={[300, 600, 900]}
              sizes="(max-width: 768px) 400px, 400px"
              quality="mid"
              format="avif"
              loading="lazy" 
              decoding="async" 
            />
          </div>
        ))}
      </div>
    </div>
  </section>
)}
