---
import '../../styles/catania/lastblock.css';
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/imageResolver';
interface Props {
  title: string;
  description?: string;
  subTitle?: string;
  image?: string;
  imageALT?: string;
  button1Text?: string;
  button1Link?: string;
}

const {
  title,
  description,
  subTitle,
  image,
  imageALT,
  button1Text,
  button1Link,
} = Astro.props;

const imageSrc = resolveImage(image);
---

<section class="lastblock">
  <div class="lastblock-container">
    <div class="lastblock-card">
      {imageSrc && (
        <div class="lastblock-media">
          <Image 
            class="lastblock-image" 
            src={imageSrc} 
            alt={imageALT || ''} 
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 500px, 600px"
            quality="mid"
            format="avif"
            loading="lazy" 
            decoding="async" 
          />
        </div>
      )}

      <div class="lastblock-content">
        {subTitle && <span class="lastblock-badge">{subTitle}</span>}
        <h2 class="lastblock-title">{title}</h2>
        {description && <p class="lastblock-description">{description}</p>}
        
        {button1Text && button1Link && (
          <div class="lastblock-actions">
            <a class="lastblock-button" href={button1Link}>
              <svg class="phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{button1Text}</span>
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
