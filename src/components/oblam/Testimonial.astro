---
import '../../styles/catania/testimonial.css';

interface TestimonialItem {
  heading?: string;
  name: string;
  testimonial: string;
  location?: string;
  rating?: string;
  company?: string;
  designation?: string;
  image?: string;
}

interface Props {
  items: TestimonialItem[];
}

const { items = [] } = Astro.props;

// Extract heading from the first item that contains a heading, fallback if none
const heading = items.find((item) => item.heading)?.heading || "What Our Customers Say About Us";
---

{items.length > 0 && (
  <section class="testimonial">
    <div class="testimonial-container">
      {heading && (
        <div class="testimonial-header">
          <h2 class="testimonial-heading">{heading}</h2>
        </div>
      )}

      <div class="testimonial-grid">
        {items.map((item) => {
          return (
            <div class="testimonial-card">
              <div class="testimonial-stars" aria-label="5 out of 5 stars">
                <svg class="star-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <svg class="star-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <svg class="star-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <svg class="star-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <svg class="star-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
              </div>
              
              <blockquote class="testimonial-quote">
                {item.testimonial}
              </blockquote>
              
              <div class="testimonial-info">
                <p class="testimonial-author">{item.name}</p>
                <p class="testimonial-meta">{item.designation}, {item.company}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
