---
import '../../styles/catania/blogs.css';
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/imageResolver';

interface Props {
  heading?: string;
  subTitle?: string;
  description?: string;
  button1Text?: string;
  button1Link?: string;
  button2Text?: string;
  button2Link?: string;
}

const {
  heading = "Our Blog",
  subTitle,
  description,
  button1Text,
  button1Link,
  button2Text,
  button2Link,
  items,
  folderPath
} = Astro.props;

const finalButton1Link = button1Text && !button1Link ? '/contactus' : button1Link;
const finalButton2Link = button2Text && !button2Link ? '/contactus' : button2Link;

// Load blogs dynamically if not passed via props
let blogs = items || [];
if (!blogs || blogs.length === 0) {
  const blogFiles = import.meta.glob('../../content/blog/*.mdx', { eager: true });
  blogs = Object.values(blogFiles)
    .map(p => (p as any).frontmatter)
    .filter(p => p.publish === 'Y' || p.publish === 'y')
    .sort((a, b) => Number(a.order || 999) - Number(b.order || 999));
}
---

{blogs.length > 0 && (
  <section class="blog-threecolumn">
    <div class="blog-threecolumn-container">
      {(heading || description) && (
        <div class="blog-threecolumn-header">
          {heading && (
            <h2 class="blog-threecolumn-heading">{heading}</h2>
          )}
          {description && (
            <p class="blog-threecolumn-section-description" style="text-align: center; max-width: 600px; margin: 12px auto 0 auto; color: var(--color-text-secondary); font-size: 16px; line-height: 1.6;">{description}</p>
          )}
        </div>
      )}

      <div class="blog-threecolumn-grid">
        {blogs.map((item) => {
          const imageSrc = resolveImage(item.image);
          const name = item.title || item.name || "Blog Title";
          const targetFolder = item.folder || folderPath || 'blog';
          
          return (
            <a href={`/${targetFolder}/${item.slug}`} class="blog-threecolumn-card">
              {imageSrc && (
                <div class="blog-threecolumn-image-wrapper">
                  <Image 
                    class="blog-threecolumn-image" 
                    src={imageSrc} 
                    alt={item.imageAltText || name} 
                    widths={[300, 600, 900]}
                    sizes="(max-width: 768px) 400px, 400px"
                    quality="mid"
                    format="avif"
                    fetchpriority="high"
                    loading="eager" 
                    decoding="async" 
                  />
                </div>
              )}
              {item.category && (
                <span style="font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--color-primary); font-weight: 600;">{item.category}</span>
              )}
              <h3 class="blog-threecolumn-title" style="margin-top: 4px;">{name}</h3>
              {item.shortDescription || item.description ? (
                <p class="blog-threecolumn-description">
                  {item.shortDescription || item.description.substring(0, 150) + "..."}
                </p>
              ) : null}
            </a>
          );
        })}
      </div>

      {(button1Text && finalButton1Link) || (button2Text && finalButton2Link) ? (
        <div class="blog-threecolumn-actions">
          {button1Text && finalButton1Link && (
            <a class="blog-threecolumn-button" href={finalButton1Link}>
              {button1Text}
              <span class="btn-arrow">→</span>
            </a>
          )}
          {button2Text && finalButton2Link && (
            <a class="blog-threecolumn-button secondary" href={finalButton2Link}>
              {button2Text}
              <span class="btn-arrow">→</span>
            </a>
          )}
        </div>
      ) : null}
    </div>
  </section>
)}
