---
import '../../styles/catania/top.css';

interface Props {
  title: string;
  description?: string;
  subTitle?: string;
  section?: string;
}

const { title, description, subTitle, section } = Astro.props;
---

<section class="top-section">
  <div class="top-container">
    <div class="top-content">
      {subTitle && <span class="top-subtitle">{subTitle}</span>}
      <h1 class="top-title">{title}</h1>
      {description && <p class="top-description">{description}</p>}
    </div>
  </div>
</section>