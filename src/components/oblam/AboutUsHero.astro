---
import '../../styles/catania/about-us-hero.css';
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/imageResolver';

interface Props {
  title: string;
  description?: string;
  subTitle?: string;
  image?: string;
  imageALT?: string;
}

const { title, description, subTitle, image, imageALT } = Astro.props;
const imageSrc = resolveImage(image);
---

<section class="about-hero">
  <div class="about-hero-container">
    <div class="about-hero-grid">
      {imageSrc && (
        <div class="about-hero-media">
          <Image 
            class="about-hero-image" 
            src={imageSrc} 
            alt={imageALT || ''} 
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            quality={75}
            format="webp"
            loading="eager" 
            decoding="async"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="about-hero-card">
        <div class="about-hero-content">
          {subTitle && <span class="about-hero-subtitle">{subTitle}</span>}
          <h2 class="about-hero-title">{title}</h2>
          {description && <p class="about-hero-description">{description}</p>}
        </div>
      </div>

    </div>
  </div>
</section>