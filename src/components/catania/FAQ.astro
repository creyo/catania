---
import "../../styles/catania/faq.css";

interface FAQItem {
  question?: string;
  answer?: string;
  title?: string;
  subTitle?: string;
  description?: string;
  bottomTitle?: string;
  bottomDescription?: string;
  buttonText?: string;
  buttonLink?: string;
  order?: string;
  publish?: string;
}

interface Props {
  items: FAQItem[];
}

const { items = [] } = Astro.props;

const sorted = [...items].sort((a, b) => Number(a.order || 999) - Number(b.order || 999));

// First item with a section title is the header
const headerItem = sorted.find(i => i.title || i.subTitle || i.description) || null;

// Only Q&A items (those that have a question field)
const qaItems = sorted.filter(i => i.question && i.question.trim() !== "");

// Bottom CTA: from item with bottomTitle or buttonText
const ctaItem = sorted.find(i => i.bottomTitle || i.buttonText) || null;
---

<section class="faq-section">
  <div class="faq-container">

    {headerItem && (headerItem.subTitle || headerItem.title || headerItem.description) && (
      <div class="faq-header">
        {headerItem.subTitle    && <span class="faq-subtitle">{headerItem.subTitle}</span>}
        {headerItem.title       && <h2   class="faq-title">{headerItem.title}</h2>}
        {headerItem.description && <p    class="faq-description">{headerItem.description}</p>}
      </div>
    )}

    {qaItems.length > 0 && (
      <ul class="faq-list" id="faq-list">
        {qaItems.map((item, idx) => (
          <li class={`faq-item${idx === 0 ? " open" : ""}`} data-faq-item>
            <button class="faq-question" aria-expanded={idx === 0 ? "true" : "false"} data-faq-btn>
              <span class="faq-question-text">{item.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" data-faq-answer>
              <div class="faq-answer-inner">
                <p class="faq-answer-text">{item.answer}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )}

    {ctaItem && (ctaItem.bottomTitle || (ctaItem.buttonText && ctaItem.buttonLink)) && (
      <div class="faq-bottom">
        {ctaItem.bottomTitle       && <h3 class="faq-bottom-title">{ctaItem.bottomTitle}</h3>}
        {ctaItem.bottomDescription && <p  class="faq-bottom-desc">{ctaItem.bottomDescription}</p>}
        {ctaItem.buttonText && ctaItem.buttonLink && (
          <a class="faq-bottom-btn" href={ctaItem.buttonLink}>
            {ctaItem.buttonText}
          </a>
        )}
      </div>
    )}

  </div>
</section>

<script>
  const list = document.getElementById("faq-list");
  if (list) {
    list.querySelectorAll<HTMLElement>("[data-faq-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest<HTMLElement>("[data-faq-item]")!;
        const isOpen = item.classList.contains("open");

        // Close all
        list.querySelectorAll<HTMLElement>("[data-faq-item]").forEach((el) => {
          el.classList.remove("open");
          el.querySelector<HTMLElement>("[data-faq-btn]")?.setAttribute("aria-expanded", "false");
        });

        // Toggle clicked
        if (!isOpen) {
          item.classList.add("open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });
  }
</script>
