---
import '../../styles/catania/contact.css';
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/imageResolver';
import { parseFieldList } from '../../utils/menuParser';

interface ContactItem {
  title?: string;
  heading?: string;
  subTitle?: string;
  subHeading?: string;
  description?: string;
  image?: string;
  imageALT?: string;
  button1Text?: string;
  button1Link?: string;
  button2Text?: string;
  button2Link?: string;
  contactFields?: string;
}

interface Props extends ContactItem {
  items?: ContactItem[];
  settings?: Record<string, string>;
}

const props = Astro.props;
const items: ContactItem[] = props.items && props.items.length > 0 ? props.items : [props];

const mainHeading = items.find((i) => i.heading)?.heading || props.heading || props.title || 'Contact Us';
const mainSubHeading = items.find((i) => i.subHeading)?.subHeading || items.find((i) => i.subTitle)?.subTitle || props.subHeading || props.subTitle;

const resolvedItems = items.map((item) => ({
  title: item.title,
  subTitle: item.subTitle,
  description: item.description,
  imageALT: item.imageALT,
  imageSrc: resolveImage(item.image),
  button1Text: item.button1Text,
  button1Link: item.button1Link,
  button2Text: item.button2Text,
  button2Link: item.button2Link,
}));

// Parse the "Contact-Fields" column from the Settings sheet.
// e.g. "name, email, message" → ["name", "email", "message"]
const fields = parseFieldList(props.contactFields);
const hasForm = fields.length > 0;
---

<section class="contact-section">
  <div class="contact-container">
    {(mainHeading || mainSubHeading) && (
      <div class="contact-header">
        {mainSubHeading && <span class="contact-badge">{mainSubHeading}</span>}
        {mainHeading && <h2 class="contact-heading">{mainHeading}</h2>}
      </div>
    )}

    {resolvedItems.length > 0 && (
      <div class="contact-grid">
        {resolvedItems.map((item) => (
          <div class="contact-card">
            {item.imageSrc && (
              <div class="contact-image-wrapper">
                <Image
                  class="contact-image"
                  src={item.imageSrc}
                  alt={item.imageALT || ''}
                  widths={[300, 600]}
                  sizes="(max-width: 768px) 100vw, 400px"
                  quality="mid"
                  format="avif"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            {item.title && <h3 class="contact-card-title">{item.title}</h3>}
            {item.description && (
              <div class="contact-card-description" set:html={item.description.replace(/\n/g, '<br/>')} />
            )}
            {(item.button1Text || item.button2Text) && (
              <div class="contact-card-actions">
                {item.button1Text && item.button1Link && (
                  <a class="contact-button" href={item.button1Link}>
                    {item.button1Text}
                  </a>
                )}
                {item.button2Text && item.button2Link && (
                  <a class="contact-button secondary" href={item.button2Link}>
                    {item.button2Text}
                  </a>
                )}
              </div>
            )}
          </div>
        ))}
      </div>
    )}

    {/* ── Sheet-driven contact form ───────────────────────────────── */}
    {hasForm && (
      <div class="contact-form-wrapper">
        <form class="contact-form" id="contact-form" novalidate>
          <input type="hidden" name="access_key" value="c5b0f176-ad3e-4df1-ab5f-2f0093fc7c82" />

          {fields.includes('name') && (
            <div class="contact-form-group">
              <label class="contact-form-label" for="contact-name">Name</label>
              <input
                class="contact-form-input"
                type="text"
                id="contact-name"
                name="name"
                placeholder="Your Name"
                required
                autocomplete="name"
              />
            </div>
          )}

          {fields.includes('email') && (
            <div class="contact-form-group">
              <label class="contact-form-label" for="contact-email">Email</label>
              <input
                class="contact-form-input"
                type="email"
                id="contact-email"
                name="email"
                placeholder="Your Email"
                required
                autocomplete="email"
              />
            </div>
          )}

          {fields.includes('phone') && (
            <div class="contact-form-group">
              <label class="contact-form-label" for="contact-phone">Phone</label>
              <input
                class="contact-form-input"
                type="tel"
                id="contact-phone"
                name="phone"
                placeholder="Phone Number"
                autocomplete="tel"
              />
            </div>
          )}

          {fields.includes('message') && (
            <div class="contact-form-group">
              <label class="contact-form-label" for="contact-message">Message</label>
              <textarea
                class="contact-form-textarea"
                id="contact-message"
                name="message"
                placeholder="Your Message"
                rows={5}
                required
              ></textarea>
            </div>
          )}

          <div class="contact-form-group">
            <button class="contact-form-submit" type="submit" id="contact-submit">
              Send Message
            </button>
            <p class="contact-form-status" id="contact-status" aria-live="polite"></p>
          </div>

        </form>
      </div>
    )}

  </div>
</section>

{hasForm && (
  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const statusEl = document.getElementById('contact-status') as HTMLParagraphElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form || !submitBtn || !statusEl) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      statusEl.textContent = '';
      statusEl.className = 'contact-form-status';

      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          statusEl.textContent = '✓ Message sent! We will get back to you soon.';
          statusEl.classList.add('contact-form-status--success');
          form.reset();
        } else {
          const err = await res.json().catch(() => ({}));
          statusEl.textContent = (err as any).message || '✗ Something went wrong. Please try again.';
          statusEl.classList.add('contact-form-status--error');
        }
      } catch {
        statusEl.textContent = '✗ Network error. Please check your connection.';
        statusEl.classList.add('contact-form-status--error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    });
  </script>
)}
