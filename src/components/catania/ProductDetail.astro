---
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/imageResolver';
import '../../styles/catania/product-detail.css';

const { item, Content } = Astro.props;
const product = item || {};
const slugFolder = Astro.props.slugFolder || 'products';

const imageSrc = resolveImage(product.image || product.imageFeatured);
const name = product.productName || product.name || product.title || "Product Name";
const categoryBadge = product.category || product.subCategory || "";
const imageAlt = product.imageAltText || product.imageALT || name;

// Split features by semicolons, commas, or line breaks
const features = product.keyFeatures 
  ? product.keyFeatures.split(/[;,\n]+/).map((f: string) => f.trim()).filter(Boolean) 
  : [];

// Split material specs if multi-line or colon-separated
const materialText = product.material || product.materialGrade || "";
const materialLines = materialText 
  ? materialText.split(/\n+/).map((l: string) => l.trim()).filter(Boolean)
  : [];

// Options pills
const optionsText = product.options || "";
const optionPills = optionsText
  ? optionsText.split(/[,/|]+|and/).map((o: string) => o.trim()).filter(Boolean)
  : [];
---

<section class="product-detail-section">
  <div class="product-detail-container">
    <a href={`/${slugFolder}`} class="product-detail-back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      Back to {slugFolder.charAt(0).toUpperCase() + slugFolder.slice(1)}
    </a>
    
    <div class="product-detail-grid">
      <!-- Left Sticky Column: Product Image Gallery -->
      <div class="product-detail-gallery">
        <div class="product-detail-image-wrapper">
          {imageSrc ? (
            <Image 
              class="product-detail-image" 
              src={imageSrc} 
              alt={imageAlt} 
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 600px"
              quality="high"
              format="avif"
              loading="eager" 
              decoding="async" 
            />
          ) : (
            <div class="product-placeholder">No Image Available</div>
          )}
        </div>
      </div>

      <!-- Right Column: Product Content (Scrolls down) -->
      <div class="product-detail-content">
        {categoryBadge && (
          <span class="product-detail-category">{categoryBadge}</span>
        )}
        <h1 class="product-detail-title">{name}</h1>
        
        {product.shortDescription && (
          <p class="product-detail-subtitle">
            {product.shortDescription}
          </p>
        )}

        {/* Material Specifications Section */}
        {materialLines.length > 0 && (
          <div class="spec-section">
            <span class="spec-label">Material Specifications</span>
            <ul class="material-list">
              {materialLines.map((line: string) => {
                const parts = line.split(':');
                if (parts.length > 1) {
                  return (
                    <li><strong>{parts[0].trim()}:</strong> {parts.slice(1).join(':').trim()}</li>
                  );
                }
                return <li>{line}</li>;
              })}
            </ul>
          </div>
        )}

        {/* Surface Finish Section */}
        {product.surfaceFinish && (
          <div class="spec-section spec-inline">
            <span class="spec-label">Surface Finish:</span>
            <span class="finish-text">{product.surfaceFinish}</span>
          </div>
        )}

        {/* Available Options Section */}
        {optionPills.length > 0 && (
          <div class="spec-section">
            <span class="spec-label">Available Options</span>
            <div class="options-pills">
              {optionPills.map((opt: string) => (
                <span class="pill">{opt}</span>
              ))}
            </div>
          </div>
        )}

        {/* Key Features Section */}
        {features.length > 0 && (
          <div class="spec-section">
            <span class="spec-label">Key Features</span>
            <ul class="features-list">
              {features.map((feature: string) => (
                <li>{feature}</li>
              ))}
            </ul>
          </div>
        )}

        {/* Additional Specifications Table */}
        {(product.subCategory || (product.materialGrade && product.materialGrade !== product.material) || product.typicalDimensions || product.useCases || product.suitableFor) && (
          <div class="spec-section">
            <span class="spec-label">Specifications</span>
            <table class="product-detail-specs-table">
              <tbody>
                {product.subCategory && (
                  <tr>
                    <th>Sub-Category</th>
                    <td>{product.subCategory}</td>
                  </tr>
                )}
                {product.materialGrade && product.materialGrade !== product.material && (
                  <tr>
                    <th>Material Grade</th>
                    <td>{product.materialGrade}</td>
                  </tr>
                )}
                {product.typicalDimensions && (
                  <tr>
                    <th>Typical Dimensions</th>
                    <td>{product.typicalDimensions}</td>
                  </tr>
                )}
                {product.useCases && (
                  <tr>
                    <th>Use Cases</th>
                    <td>{product.useCases}</td>
                  </tr>
                )}
                {product.suitableFor && (
                  <tr>
                    <th>Suitable For</th>
                    <td>{product.suitableFor}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        )}

        {/* Markdown Content */}
        {Content && (
          <div class="product-body">
            <Content />
          </div>
        )}

        <div class="product-detail-actions">
          <a href="/getintouch" class="product-detail-button">
            Request a Quote
            <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

