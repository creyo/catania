---
import '../../styles/steelcraft/products.css';
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/imageResolver';

interface Props {
  heading?: string;
  subTitle?: string;
  description?: string;
  button1Text?: string;
  button1Link?: string;
  button2Text?: string;
  button2Link?: string;
  items?: any[];
  folderPath?: string;
}

const {
  heading,
  subTitle,
  description,
  button1Text,
  button1Link,
  button2Text,
  button2Link,
  items,
  folderPath
} = Astro.props;

const finalButton1Link = button1Link;
const finalButton2Link = button2Link;

// Load products dynamically if not passed via props
let products = (items || []).filter(p => p && (p.publish === 'Y' || p.publish === 'y' || !p.publish));
if (!products || products.length === 0) {
  const productFiles = import.meta.glob('../../content/products/*.mdx', { eager: true });
  products = Object.values(productFiles)
    .map(p => (p as any).frontmatter)
    .filter(p => p && (p.publish === 'Y' || p.publish === 'y' || !p.publish))
    .sort((a, b) => Number(a.order || 999) - Number(b.order || 999));
}
---

{products.length > 0 && (
  <section class="threecolumn">
    <div class="threecolumn-container">
      {(heading || description) && (
        <div class="threecolumn-header">
          {heading && (
            <h2 class="threecolumn-heading">{heading}</h2>
          )}
          {description && (
            <p class="threecolumn-section-description" style="text-align: center; max-width: 600px; margin: 12px auto 0 auto; color: var(--color-text-secondary); font-size: 16px; line-height: 1.6;">{description}</p>
          )}
        </div>
      )}

      <div class="threecolumn-grid">
        {products.map((item) => {
          const imageSrc = resolveImage(item.image || item.imageFeatured);
          const name = item.productName || item.title || item.name || "";
          const subCategory = item.subCategory || "";
          const mainCategory = item.category || "";
          const leftLabel = subCategory || mainCategory;
          const rightBadge = subCategory && mainCategory ? mainCategory : (item.materialGrade || item.surfaceFinish || item.options || "");
          const features = item.keyFeatures ? item.keyFeatures.split(/[;,\n]+/).map((f: string) => f.trim()).filter(Boolean) : [];
          const targetFolder = item.folder || folderPath || 'products';
          const itemHref = targetFolder ? `/${targetFolder}/${item.slug}` : `/${item.slug}`;
          
          return (
            <a href={itemHref} class="product-card">
              {imageSrc && (
                <div class="product-card-image-wrapper">
                  <Image 
                    class="product-card-image" 
                    src={imageSrc} 
                    alt={item.imageAltText || item.imageALT || name} 
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 768px) 100vw, 600px"
                    quality="high"
                    format="avif"
                    loading="eager" 
                    decoding="async" 
                  />
                </div>
              )}
              <div class="product-card-body">
                <div class="product-card-header">
                  {leftLabel && <span class="product-card-category">{leftLabel}</span>}
                  {rightBadge && <span class="product-card-badge">{rightBadge}</span>}
                </div>
                {name && <h3 class="product-card-title">{name}</h3>}
                {(item.shortDescription || item.description) && (
                  <p class="product-card-description">
                    {item.shortDescription || (typeof item.description === 'string' ? item.description : '')}
                  </p>
                )}
                {features.length > 0 && (
                  <ul class="product-card-features">
                    {features.slice(0, 3).map((f: string) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                )}
                <div class="product-card-footer">
                  <span class="product-card-link">View Details →</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      {(button1Text && finalButton1Link) || (button2Text && finalButton2Link) ? (
        <div class="threecolumn-actions">
          {button1Text && finalButton1Link && (
            <a class="threecolumn-button" href={finalButton1Link}>
              {button1Text}
              <span class="btn-arrow">→</span>
            </a>
          )}
          {button2Text && finalButton2Link && (
            <a class="threecolumn-button secondary" href={finalButton2Link}>
              {button2Text}
              <span class="btn-arrow">→</span>
            </a>
          )}
        </div>
      ) : null}
    </div>
  </section>
)}
