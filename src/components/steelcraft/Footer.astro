                  </a>
                );
              }
              if (label.includes('linkedin') || href.includes('linkedin.com')) {
                return (
                  <a class="footer-social-link" href={href} target="_blank" rel="noopener noreferrer" aria-label="Connect with us on LinkedIn" id="social-linkedin">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.94 8.5A1.56 1.56 0 116.93 5.4a1.56 1.56 0 01.01 3.1z"/><path fill="currentColor" d="M5.5 9.75h2.88V19H5.5V9.75z"/><path fill="currentColor" d="M10.19 9.75h2.76v1.26h.04c.38-.73 1.32-1.5 2.71-1.5 2.9 0 3.44 1.9 3.44 4.37V19h-2.88v-4.53c0-1.08-.02-2.47-1.5-2.47-1.5 0-1.73 1.17-1.73 2.39V19h-2.84V9.75z"/></svg>
                  </a>
                );
              }
              if (label.includes('facebook') || href.includes('facebook.com')) {
                return (
                  <a class="footer-social-link" href={href} target="_blank" rel="noopener noreferrer" aria-label="Follow us on Facebook" id="social-facebook">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  </a>
                );
              }
              return null;
            })
          ) : (
            <>
              <a class="footer-social-link" href="https://www.instagram.com/steelcraft.ae" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram" id="social-instagram">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M170.663 256.157c-.083-47.121 38.055-85.4 85.167-85.483 47.121-.092 85.407 38.03 85.499 85.16.091 47.129-38.047 85.4-85.176 85.492-47.112.09-85.399-38.039-85.49-85.169zm-46.108.091c.141 72.602 59.106 131.327 131.69 131.186 72.592-.141 131.35-59.09 131.209-131.692-.141-72.577-59.114-131.335-131.715-131.194-72.585.141-131.325 59.115-131.184 131.7zm237.104-137.091c.033 16.953 13.817 30.681 30.772 30.648 16.961-.033 30.689-13.811 30.664-30.764-.033-16.954-13.818-30.69-30.78-30.657-16.962.033-30.689 13.818-30.656 30.773zm-208.696 345.4c-24.958-1.087-38.511-5.234-47.543-8.709-11.961-4.629-20.496-10.178-29.479-19.094-8.966-8.95-14.532-17.46-19.202-29.397-3.508-9.032-7.73-22.569-8.9-47.527-1.269-26.982-1.559-35.077-1.683-103.432-.133-68.339.116-76.434 1.294-103.441 1.069-24.942 5.242-38.512 8.709-47.536 4.628-11.977 10.161-20.496 19.094-29.479 8.949-8.982 17.459-14.532 29.403-19.202 9.025-3.525 22.561-7.714 47.511-8.9 26.998-1.277 35.085-1.551 103.423-1.684 68.353-.132 76.448.108 103.456 1.295 24.94 1.086 38.51 5.217 47.527 8.709 11.968 4.628 20.503 10.144 29.478 19.094 8.974 8.95 14.54 17.443 19.21 29.412 3.524 9 7.714 22.553 8.892 47.494 1.285 26.999 1.576 35.095 1.7 103.433.132 68.355-.117 76.451-1.302 103.441-1.087 24.958-5.226 38.52-8.709 47.561-4.629 11.952-10.161 20.487-19.103 29.471-8.941 8.949-17.451 14.531-29.403 19.201-9.009 3.517-22.561 7.714-47.494 8.9-26.998 1.269-35.086 1.559-103.448 1.684-68.338.132-76.424-.125-103.431-1.294zM149.977 1.773c-27.239 1.285-45.843 5.648-62.101 12.018-16.829 6.561-31.095 15.354-45.286 29.604C28.381 57.653 19.655 71.944 13.144 88.79c-6.303 16.299-10.575 34.912-11.778 62.168C.172 178.264-.102 186.973.031 256.489c.133 69.508.439 78.234 1.741 105.547 1.302 27.231 5.649 45.828 12.019 62.093 6.569 16.83 15.353 31.088 29.611 45.288 14.25 14.201 28.55 22.918 45.404 29.438 16.282 6.295 34.902 10.583 62.15 11.778 27.305 1.203 36.022 1.468 105.521 1.335 69.532-.132 78.25-.439 105.555-1.733 27.239-1.303 45.826-5.665 62.1-12.019 16.829-6.586 31.095-15.353 45.288-29.611 14.191-14.251 22.917-28.55 29.428-45.405 6.304-16.282 10.592-34.903 11.777-62.134 1.195-27.322 1.478-36.048 1.344-105.556-.133-69.516-.447-78.225-1.741-105.523-1.294-27.255-5.657-45.844-12.019-62.118-6.577-16.829-15.352-31.079-29.602-45.287-14.25-14.192-28.55-22.935-45.404-29.429-16.29-6.305-34.903-10.601-62.15-11.779C333.747.164 325.03-.102 255.506.031c-69.507.133-78.224.431-105.529 1.742z"/></svg>
              </a>
              <a class="footer-social-link" href="https://www.linkedin.com/company/steelcraft-uae/" target="_blank" rel="noopener noreferrer" aria-label="Connect with us on LinkedIn" id="social-linkedin">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.94 8.5A1.56 1.56 0 116.93 5.4a1.56 1.56 0 01.01 3.1z"/><path fill="currentColor" d="M5.5 9.75h2.88V19H5.5V9.75z"/><path fill="currentColor" d="M10.19 9.75h2.76v1.26h.04c.38-.73 1.32-1.5 2.71-1.5 2.9 0 3.44 1.9 3.44 4.37V19h-2.88v-4.53c0-1.08-.02-2.47-1.5-2.47-1.5 0-1.73 1.17-1.73 2.39V19h-2.84V9.75z"/></svg>
              </a>
            </>
          )}
        </div>
      </div>

      <div class="footer-column">
        <h3 class="footer-heading">Quick Links</h3>
        <ul class="footer-links">
          {quickLinks.map((link) => (
            <li>
              <a class="footer-link" href={link.href} id={`footer-link-${link.label.toLowerCase().replace(/\s+/g, '-')}`}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-column">
        <h3 class="footer-heading">Industries & Solutions</h3>
        <ul class="footer-links">
          {industryLinks.map((link) => (
            <li>
              <a class="footer-link" href={link.href} id={`footer-link-${link.label.toLowerCase().replace(/\s+/g, '-')}`}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-column">
        <h3 class="footer-heading">Contact</h3>
        <div class="footer-links">
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <a class="footer-contact-link" href={phoneHref} id="footer-phone">{phoneNumber}</a>
          </div>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
            <a class="footer-contact-link" href={emailHref} id="footer-email">{email}</a>
          </div>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{address}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {currentYear} Steelcraft. All rights reserved.
      </p>
      <div class="footer-bottom-links">
        <a class="footer-bottom-link" href="/privacy-policy" id="footer-privacy">Privacy Policy</a>
        <a class="footer-bottom-link" href="/terms" id="footer-terms">Terms of Service</a>
        <a class="footer-bottom-link" href="/sitemap.xml" id="footer-sitemap">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

