---
import { Image } from 'astro:assets';
import '../../styles/steelcraft/footer.css';
import { parseFlatMenu } from '../../utils/menuParser';
import { resolveImage } from '../../utils/imageResolver';

interface Props {
  settings?: Record<string, string>;
}

const { settings } = Astro.props;
const currentYear = new Date().getFullYear();

const logoAsset = resolveImage(settings?.logo);

const quickLinks = parseFlatMenu(settings?.footerMenu);

const industryLinks = parseFlatMenu(settings?.serviceMenu || settings?.servicesMenu || settings?.industryMenu);

const socialLinks = parseFlatMenu(settings?.socialButton || settings?.socialLinks);

const phoneNumber = '+971 6 535 8448';
const phoneHref = 'tel:+97165358448';
const email = 'info@steelcraftuae.com';
const emailHref = 'mailto:info@steelcraftuae.com';
const address = 'Sharjah & Dubai, United Arab Emirates';
---

<footer class="site-footer" id="site-footer">
  <div class="footer-main">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href="/" aria-label={`${settings?.name || 'Steelcraft'} - Go to homepage`}>
          {logoAsset && (
            <Image
              src={logoAsset}
              alt={`${settings?.name || 'Steelcraft'} logo`}
              width={200}
              loading="lazy"
              decoding="async"
              format="webp"
              quality={85}
            />
          )}
        </a>
        <p class="footer-description">
          Premier manufacturer & supplier of commercial kitchen equipment, industrial bakery solutions, and custom stainless steel fabrication across the UAE & Middle East.
        </p>
        <div class="footer-social" aria-label="Social media links">
          {socialLinks.length > 0 ? (
            socialLinks.map((item) => {
              const label = item.label.toLowerCase();
              const href = item.href;

              if (label.includes('instagram') || href.includes('instagram.com')) {
                return (
                  <a class="footer-social-link" href={href} target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram" id="social-instagram">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M170.663 256.157c-.083-47.121 38.055-85.4 85.167-85.483 47.121-.092 85.407 38.03 85.499 85.16.091 47.129-38.047 85.4-85.176 85.492-47.112.09-85.399-38.039-85.49-85.169zm-46.108.091c.141 72.602 59.106 131.327 131.69 131.186 72.592-.141 131.35-59.09 131.209-131.692-.141-72.577-59.114-131.335-131.715-131.194-72.585.141-131.325 59.115-131.184 131.7zm237.104-137.091c.033 16.953 13.817 30.681 30.772 30.648 16.961-.033 30.689-13.811 30.664-30.764-.033-16.954-13.818-30.69-30.78-30.657-16.962.033-30.689 13.818-30.656 30.773zm-208.696 345.4c-24.958-1.087-38.511-5.234-47.543-8.709-11.961-4.629-20.496-10.178-29.479-19.094-8.966-8.95-14.532-17.46-19.202-29.397-3.508-9.032-7.73-22.569-8.9-47.527-1.269-26.982-1.559-35.077-1.683-103.432-.133-68.339.116-76.434 1.294-103.441 1.069-24.942 5.242-38.512 8.709-47.536 4.628-11.977 10.161-20.496 19.094-29.479 8.949-8.982 17.459-14.532 29.403-19.202 9.025-3.525 22.561-7.714 47.511-8.9 26.998-1.277 35.085-1.551 103.423-1.684 68.353-.132 76.448.108 103.456 1.295 24.94 1.086 38.51 5.217 47.527 8.709 11.968 4.628 20.503 10.144 29.478 19.094 8.974 8.95 14.54 17.443 19.21 29.412 3.524 9 7.714 22.553 8.892 47.494 1.285 26.999 1.576 35.095 1.7 103.433.132 68.355-.117 76.451-1.302 103.441-1.087 24.958-5.226 38.52-8.709 47.561-4.629 11.952-10.161 20.487-19.103 29.471-8.941 8.949-17.451 14.531-29.403 19.201-9.009 3.517-22.561 7.714-47.494 8.9-26.998 1.269-35.086 1.559-103.448 1.684-68.338.132-76.424-.125-103.431-1.294zM149.977 1.773c-27.239 1.285-45.843 5.648-62.101 12.018-16.829 6.561-31.095 15.354-45.286 29.604C28.381 57.653 19.655 71.944 13.144 88.79c-6.303 16.299-10.575 34.912-11.778 62.168C.172 178.264-.102 186.973.031 256.489c.133 69.508.439 78.234 1.741 105.547 1.302 27.231 5.649 45.828 12.019 62.093 6.569 16.83 15.353 31.088 29.611 45.288 14.25 14.201 28.55 22.918 45.404 29.438 16.282 6.295 34.902 10.583 62.15 11.77