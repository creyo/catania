---
import '../../styles/catania/mission.css';

interface Props {
  title: string;
  description?: string;
  subTitle?: string;
  title2?: string;
  description2?: string;
  section?: string;
}

const { title, description, subTitle, title2, description2, section } = Astro.props;
---

<section class="mission-section no-bg">
  <div class="mission-container">
    <div class="mission-grid two-cols">
      <div class="mission-col-left">
        {subTitle && <span class="mission-subtitle">{subTitle}</span>}
        <h2 class="mission-title">{title}</h2>
        {description && <p class="mission-description">{description}</p>}
      </div>
      <div class="mission-col-right">
        {title2 && <h3 class="mission-title secondary">{title2}</h3>}
        {description2 && description2.trim() && (
          <ul class="mission-list">
            {description2.trim().split('\n').map(item => (
              <li class="mission-list-item">
                <span class="mission-list-icon">
                  <svg viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                </span>
                <span class="mission-list-text">{item}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>