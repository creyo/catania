---
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/imageResolver';
import '../../styles/steelcraft/home-top.css';

interface Props {
  title: string;
  description?: string;
  subTitle?: string;
  image?: string;
  imageALT?: string;
  button1Text?: string;
  button1Link?: string;
  button2Text?: string;
  button2Link?: string;
}

const {
  title,
  description,
  subTitle,
  image,
  imageALT,
  button1Text,
  button1Link,
  button2Text,
  button2Link,
} = Astro.props;

const imageSrc = resolveImage(image);
---

<section class="hero">
  <div class="container hero__container reveal-on-scroll">
    <div class="hero__content">
      <h1 class="hero__title">{title}</h1>
      {description && <p class="hero__description">{description}</p>}
      {(button1Text && button1Link) ? (
        <div class="hero__actions">
          <a class="btn btn-primary" href={button1Link}>
            {button1Text}
          </a>
        </div>
      ) : null}
    </div>

    <div class="hero__visual">
      <div class="hero__image-wrapper">
        {imageSrc ? (
          <Image
            src={imageSrc}
            alt={imageALT || title || 'Luxury Stainless Steel Kitchen'}
            class="hero__image"
            widths={[600, 1200, 1600]}
            sizes="(max-width: 768px) 600px, 1200px"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        ) : (
          <img
            src="/images/catania-homepage-section-2-image-1.webp"
            alt={imageALT || title || 'Luxury Stainless Steel Kitchen'}
            class="hero__image"
            loading="eager"
          />
        )}
      </div>
    </div>
  </div>
</section>

<script>
  function setupReveal() {
    const observerOptions = {
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-visible');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });
  }

  setupReveal();
  document.addEventListener('astro:after-swap', setupReveal);
</script>
