<script>
  function setupHeader() {
    const header = document.querySelector('.header');
    if (!header) return;

    const toggleBtn = header.querySelector('.mobile-menu-toggle');
    const mobileOverlay = header.querySelector('.mobile-menu-overlay');

    // 1. Mobile Menu Toggle
    function toggleMobileMenu(force?: boolean) {
      const isOpen = force !== undefined ? force : !mobileOverlay?.classList.contains('is-open');
      mobileOverlay?.classList.toggle('is-open', isOpen);
      toggleBtn?.classList.toggle('is-active', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMobileMenu();
    });

    // Close mobile menu when clicking outside of it
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target instanceof Element && mobileOverlay?.classList.contains('is-open')) {
        if (!target.closest('.mobile-menu-overlay') && !target.closest('.mobile-menu-toggle')) {
          toggleMobileMenu(false);
        }
      }
    });

    // Close mobile menu when clicking links
    header.querySelectorAll('.mobile-menu-overlay a').forEach(link => {
      link.addEventListener('click', () => toggleMobileMenu(false));
    });

    // 2. Mobile Submenu Toggle (Accordion style)
    header.querySelectorAll('.mobile-dropdown-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const parent = btn.closest('.mobile-has-dropdown');
        if (parent) {
          parent.classList.toggle('is-open');
        }
      });
    });

    // 3. Desktop Submenu Toggle (for Touch/Click Support)
    const dropdownToggles = header.querySelectorAll('.nav-desktop .dropdown-toggle');
    dropdownToggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const parent = toggle.parentElement;
        if (parent) {
          const wasOpen = parent.classList.contains('is-open');
          // Close other dropdowns
          header.querySelectorAll('.nav-desktop .has-dropdown').forEach(item => {
            item.classList.remove('is-open');
          });
          // Toggle current
          if (!wasOpen) {
            parent.classList.add('is-open');
          }
        }
      });
    });

    // Close desktop dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target instanceof Element && !target.closest('.has-dropdown')) {
        header.querySelectorAll('.nav-desktop .has-dropdown').forEach(item => {
          item.classList.remove('is-open');
        });
      }
    });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
