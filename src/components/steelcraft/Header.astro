      <!-- Hamburger Menu Toggle (Mobile Only) -->
      <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-label="Toggle menu">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu-overlay">
    <nav class="nav-mobile" aria-label="Mobile navigation">
      <ul class="mobile-nav-list">
        {
          navItems.map((item) => (
            <li class={item.subItems ? 'mobile-has-dropdown' : ''}>
              {item.subItems ? (
                <div>
                  <button class="mobile-dropdown-toggle" type="button">
                    {item.label}
                    <svg class="mobile-dropdown-arrow" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>
                  <ul class="mobile-dropdown-menu">
                    {item.subItems.map(subItem => (
                      <li><a href={subItem.href}>{subItem.label}</a></li>
                    ))}
                  </ul>
