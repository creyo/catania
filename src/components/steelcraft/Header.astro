---
import { Image } from 'astro:assets';
import '../../styles/steelcraft/header.css';
import { parseMenuString, parseFlatMenu } from '../../utils/menuParser';
import { resolveImage } from '../../utils/imageResolver';

interface Props {
  settings?: Record<string, string>;
}

const { settings } = Astro.props;
const currentPath = Astro.url.pathname;

const logoAsset = resolveImage(settings?.logo);

const navItems = parseMenuString(settings?.topMenu);
const socialLinks = parseFlatMenu(settings?.socialButton || settings?.socialLinks);

const isActive = (href?: string) => {
  if (!href) return false;
  if (href === '/' || href === '#') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="header">
  <div class="header-container">
    <!-- Left: Logo -->
    <a href="/" class="logo" aria-label={`${settings?.name || 'Steelcraft'} home`}>
      {logoAsset && (
        <Image src={logoAsset} alt={`${settings?.name || 'Steelcraft'} logo`} loading="eager" fetchpriority="high" />
      )}
    </a>

    <!-- Center: Desktop Links -->
    <nav class="nav-desktop" aria-label="Desktop navigation">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li class={item.subItems ? 'has-dropdown' : ''}>
              {item.subItems ? (
                <a href="#" class="nav-link dropdown-toggle" role="button" aria-haspopup="true" aria-expanded="false">
                  {item.label}
                  <svg class="dropdown-arrow" viewBox="0 0 20 20" width="12" height="12" fill="currentColor">
                    <path d="M5.2 7.6L10 12.4l4.8-4.8 1.2 1.2-6 6-6-6 1.2-1.2z"/>
                  </svg>
                </a>
                <ul class="dropdown-menu">
                  {item.subItems.map(subItem => (
                    <li><a href={subItem.href}>{subItem.label}</a></li>
                  ))}
                </ul>
              ) : (
                <a href={item.href} class={`nav-link ${isActive(item.href) ? 'is-active' : ''}`.trim()}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Right: Social & Contact Icons + Hamburger (Mobile Only) -->
    <div class="header-right">
      <ul class="social-list">
        {socialLinks.length > 0 ? (
          socialLinks.map((item) => {
            const label = item.label.toLowerCase();
            const href = item.href;

            if (label.includes('instagram') || href.includes('instagram.com')) {
              return (
                <li>
